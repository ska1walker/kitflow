{
  "name": "kitflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--use-env-proxy next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=--use-env-proxy next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src scripts browser playwright.config.ts",
    "test": "vitest run",
    "hubspot-setup": "node --use-env-proxy scripts/hubspot-setup.mjs",
    "link": "node scripts/link.mjs",
    "test:db": "vitest run --config vitest.echt.mts",
    "test:browser": "playwright test",
    "test:ui": "node test-ui/bilder.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
