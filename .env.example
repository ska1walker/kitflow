# HubSpot ist die einzige Datenbasis. Ohne Token laeuft die Oberflaeche mit
# Beispieldaten weiter und kennzeichnet sie als solche.
# Private App mit den Scopes aus docs/datenmodell.md.
HUBSPOT_TOKEN=

# Mailversand ueber Resend, Domain hubsport.club (docs/offen.md).
RESEND_API_KEY=

# HMAC-Schluessel fuer die signierten Links (docs/konzept.md).
LINK_SECRET=
