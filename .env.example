# HubSpot ist die einzige Datenbasis. Ohne Anmeldung laeuft die Oberflaeche mit
# Beispieldaten weiter und kennzeichnet sie als solche.
# Service-Schluessel mit den Scopes aus docs/datenmodell.md.
HUBSPOT_TOKEN=

# Nur in der Claude-Cloud-Umgebung: dort haengt der Schluessel an den
# Zugangsdaten fuer api.hubapi.com und der Proxy setzt den Header. Dann bleibt
# HUBSPOT_TOKEN leer und hier steht 1.
HUBSPOT_AUTH_VIA_PROXY=

# Mailversand ueber Resend, Domain hubsport.club (docs/offen.md).
RESEND_API_KEY=

# HMAC-Schluessel fuer die signierten Links (docs/konzept.md). Mindestens 32
# Zeichen, sonst gilt er als nicht gesetzt und kein Link funktioniert.
# Erzeugen mit:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Wird er getauscht, sind alle bereits verschickten Links ungueltig.
LINK_SECRET=

# Eigene Datenbank fuer Vorgaenge (docs/datenbank.md). PFLICHT: seit dem Umzug
# leben die Vorgaenge dort. Fehlen die beiden, findet kitflow keinen einzigen
# Vorgang mehr und jede Statusseite meldet eine Stoerung.
# Die Adresse ist kein Geheimnis; SUPABASE_URL tut es auch.
NEXT_PUBLIC_SUPABASE_URL=

# Service-Schluessel. Umgeht RLS und darf NIE in den Browser gelangen.
SUPABASE_SERVICE_ROLE_KEY=

# Oeffentlicher Schluessel derselben Datenbank. PFLICHT fuer die Anmeldung der
# Spartenleitung (/sparte). Er darf in den Browser – anders als der
# Dienst-Schluessel darueber, der RLS umgeht.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wer sich an /sparte anmelden darf, Komma getrennt. Gross/Kleinschreibung egal.
# Fehlt die Variable, kommt NIEMAND hinein – nicht: jeder (src/lib/sparte.ts).
# Ein Konto in Supabase allein reicht nie; diese Liste entscheidet.
SPARTE_EMAILS=

# Absender und Antwortadresse der kitflow-Mails. Beide optional, es gibt
# Vorgaben (src/lib/mail.ts).
MAIL_ABSENDER=
MAIL_ANTWORT=

# Testbremse: leitet JEDE Mail an diese eine Adresse um und schreibt in die
# Mail, dass sie umgeleitet wurde. Gehoert auf Preview, nicht auf Production.
MAIL_NUR_AN=

# Adresse, unter der kitflow erreichbar ist – fuer die Links in den Mails und
# den Rueckweg der Anmeldung. Fehlt sie, nimmt kitflow VERCEL_URL.
KITFLOW_BASIS=

# Geheimnis fuer den taeglichen Erinnerungslauf (/api/erinnerungen, vercel.json).
# Vercel setzt es selbst, wenn man es im Projekt anlegt, und schickt es als
# "Authorization: Bearer ...". Mindestens 16 Zeichen, sonst antwortet der
# Endpunkt 503 – die Adresse steht offen im Netz, der Zeitgeber schuetzt sie nicht.
CRON_SECRET=

# Die Haendler, an die eine Angebotsanfrage geht (M4). Je Haendler mit | getrennt:
# Firma|Ansprechpartner|Adresse, Haendler untereinander mit Komma. Der mittlere
# Teil darf leer bleiben, dann steht "Sehr geehrte Damen und Herren" in der Mail.
#   Intersport Uelzen|Herr Hillebrecht|...,11teamsports|Herr Bormann|...
# FEHLT die Variable, geht KEINE Anfrage raus. Die Liste wird trotzdem
# bestaetigt, der Vorgang bleibt auf Stufe 1 liegen und der Verlauf sagt warum.
HAENDLER=

# Telegram-Bot fuer die Freigabe-Meldung (M4 geht erst nach Freigabe raus).
# TELEGRAM_TOKEN kommt vom BotFather, TELEGRAM_CHAT ist die Chat- oder
# Gruppen-ID (bei Gruppen negativ, z. B. -1001234567890). Fehlt eines von
# beiden, geht keine Nachricht raus -- die Freigabe wartet trotzdem sichtbar
# auf /sparte. In der Nachricht stehen NIE Spielernamen.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# Todoist: eine Aufgabe je offener Freigabe. Der Token steht in Todoist unter
# Einstellungen > Integrationen > Entwickler. Ohne TODOIST_PROJEKT landet die
# Aufgabe im Posteingang -- das ist kein Fehler, nur weniger aufgeraeumt.
#
# Die Projekt-ID hat das neue, alphanumerische Format (z. B. 6f8v4J3qcVwmhc7M),
# nicht die alte Zahlenform. kitflow spricht deshalb api/v1 an, nicht rest/v2.
TODOIST_TOKEN=
TODOIST_PROJEKT=
