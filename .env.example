# HubSpot ist die einzige Datenbasis. Ohne Anmeldung laeuft die Oberflaeche mit
# Beispieldaten weiter und kennzeichnet sie als solche.
# Service-Schluessel mit den Scopes aus docs/datenmodell.md.
HUBSPOT_TOKEN=

# Nur in der Claude-Cloud-Umgebung: dort haengt der Schluessel an den
# Zugangsdaten fuer api.hubapi.com und der Proxy setzt den Header. Dann bleibt
# HUBSPOT_TOKEN leer und hier steht 1.
HUBSPOT_AUTH_VIA_PROXY=

# Mailversand ueber Resend, Domain hubsport.club (docs/offen.md).
RESEND_API_KEY=

# HMAC-Schluessel fuer die signierten Links (docs/konzept.md). Mindestens 32
# Zeichen, sonst gilt er als nicht gesetzt und kein Link funktioniert.
# Erzeugen mit:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Wird er getauscht, sind alle bereits verschickten Links ungueltig.
LINK_SECRET=

# Eigene Datenbank fuer Vorgaenge (docs/datenbank.md). Noch an keiner Seite
# angeschlossen: fehlen die beiden, ist die Schicht nicht aktiv und die App
# laeuft unveraendert auf HubSpot.
# Die Adresse ist kein Geheimnis; SUPABASE_URL tut es auch.
NEXT_PUBLIC_SUPABASE_URL=

# Service-Schluessel. Umgeht RLS und darf NIE in den Browser gelangen.
SUPABASE_SERVICE_ROLE_KEY=
